s = input("Enter a string:")
def is_palindrome(s):
    i=0
    n=len(s)
    while i<n//2-1:
        if s[i]!=s[n-1-i]:
            return False
        else:
            i+=1
    return True
print(is_palindrome(s))
def simple_one(s):
    if s==s[::-1]:
        return True
    else:
        return False
print(simple_one(s))