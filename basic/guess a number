import tkinter as tk
import random
def guess_number(n):
    window = tk.Tk()
    window.title("Guess the Number Game")
    window.geometry("400x200")
    entry = tk.Entry(window)
    entry.pack()
    tip = tk.Label(window,text="Guess a number between 1 and 100")
    tip.pack()
    result = tk.Label(window, text="")
    result.pack()
    def check_guess():
        guess = int(entry.get())
        if guess < n:
            result.config(text="Too low! Try again.")
        elif guess > n:
            result.config(text="Too high! Try again.")
        else:
            result.config(text="Congratulations! You guessed the number.")
    button = tk.Button(window, text="Check Guess", command=check_guess)
    button.pack()   
    window.mainloop()
guess_number(random.randint(1, 100))