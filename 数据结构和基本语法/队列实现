#队列：先进先出
class Queue:
    def __init__(self):
        self.items = []
    def is_empty(self):
        return self.items == []
    def enqueue(self,x):
        self.items.insert(0,x)
    def dequeue(self):
        if not self.is_empty():
            return self.items.pop()
        else:
            return None
    def size(self):
        return len(self.items)
    def peek(self):
        return self.items[-1]
q=Queue()
q.enqueue(1)
q.enqueue(2)
q.enqueue(3)
print(q.dequeue())
print(q.size())
print(q.peek())